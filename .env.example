# Copy to .env and fill in.  cp .env.example .env

# --- model access: Vertex AI ----------------------------------------------
# Auth comes from Application Default Credentials, not from a key in this file.
# In Cloud Shell you are already authenticated. On a laptop, run once:
#     gcloud auth application-default login
# Written by ./setup.sh: it takes the project your lab platform gave you, or
# creates a long-running-<random> one and attaches a billing account. Left blank
# on purpose — a plausible-looking placeholder here gets adopted silently and
# everything deploys into somebody else's project.
GOOGLE_CLOUD_PROJECT=
# Where the MODEL is served. "global" is right for Gemini on Vertex.
GOOGLE_CLOUD_LOCATION=global
# Where SERVICES live: Cloud Run, Cloud SQL, buckets, Pub/Sub, Scheduler.
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# On Vertex the "-latest" aliases do not exist and return 404. Use a pinned id.
# Known good: gemini-2.5-flash, gemini-2.5-flash-lite
ADK_MODEL=gemini-2.5-flash

# --- local services -------------------------------------------------------
# Written by ./deploy-venue.sh, which setup.sh runs for you. Left blank on
# purpose: an agent pointed at a localhost venue you never started fails in a
# way that looks like the agent is broken. `. ./set_env.sh local` points one
# terminal at a venue on :8080 without editing this file.
VENUE_URL=
AGENT_URL=http://127.0.0.1:8000
VENUE_PORT=8080

# The memory file: $MEMORY_DIR/$MEMORY_USER.md. MEMORY_USER names the FILE
# only. The ADK identity is app "concert", user "user" on every surface.
MEMORY_DIR=./memory
MEMORY_USER=userx

# --- Chapter 6 only: written by ./setup-cloud-state.sh and ./deploy-agent.sh -
# CLOUD_SESSION_SERVICE_URI=postgresql+asyncpg://adk:<password>@/adk?host=/cloudsql/<connection>
# CLOUD_ARTIFACT_SERVICE_URI=gs://<your-bucket>/artifacts
# STATE_BUCKET=gs://<your-bucket>
# SQL_CONNECTION_NAME=<project>:<region>:workshop-sessions
# AGENT_SERVICE_URL=https://<your-agent>.run.app
